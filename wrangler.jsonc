{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "car-flip-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "car-flip-tracker-db",
      "database_id": "2cb517b5-e5aa-45f2-bd68-9cef6a243efa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "car-flip-tracker-storage"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "BOIAjX0t7Vt1RqSPZSzWFQpfwKUqCdwzfdxeVrJHmVKryF5LmnHtYuB8SpNqm-7-2m2GKCSJI7cRvOwrq1RtGHI"
  }
}
